# All variables are optional — the app works out of the box with no configuration.
# Secrets are auto-generated on first startup and stored in /data/config.json.

# Override the auto-generated encryption key (used to encrypt platform credentials)
# ENCRYPTION_KEY=

# Override the auto-generated JWT signing secret
# JWT_SECRET=

# Server port (default: 3000)
# PORT=3000

# Timezone for rollups and date boundaries (IANA format, default: UTC)
# Examples: America/New_York, America/Chicago, America/Los_Angeles, Europe/London
# TZ=America/New_York

# Lock CORS to a specific origin (default: allow all)
# CORS_ORIGIN=https://rippl3fx.example.com
